# Crea secretos hexadecimales con: openssl rand -hex 32
COMPOSE_PROJECT_NAME=rotta
MONGO_ROOT_USERNAME=rotta_root
MONGO_ROOT_PASSWORD=CAMBIAR_POR_UN_SECRETO_HEXADECIMAL
MONGO_APP_USERNAME=rotta_app
MONGO_APP_PASSWORD=CAMBIAR_POR_OTRO_SECRETO_HEXADECIMAL

# Obligatorio como base por defecto; cada club puede tener su propia base.
DB_NAME=rotta
CENTRAL_DB_NAME=rotta
DEFAULT_CLUB=
ROOT_DOMAIN=

# Google Identity y administrador inicial.
GOOGLE_CLIENT_ID=
ADMIN_EMAILS=

# El acceso público debería ser HTTPS a través de Caddy/Nginx.
COOKIE_SECURE=true

# Puerto local al que se conecta el proxy inverso del VPS.
ROTTA_PORT=8000
