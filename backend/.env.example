MONGO_URL=mongodb://localhost:27017
DB_NAME=rotta
CORS_ORIGINS=http://localhost:5173

# Identificador de cliente OAuth de Google Cloud (termina en .apps.googleusercontent.com)
GOOGLE_CLIENT_ID=
# Correos de Google que entran siempre como administradores, separados por comas
ADMIN_EMAILS=
# En local va sin HTTPS, así que la cookie no puede ser "Secure". En internet, déjalo en true.
COOKIE_SECURE=false
# Notificaciones al móvil. Sin estas tres no se ofrecen ni se envían.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Un contacto (web o mailto:), para que los servicios de avisos sepan quién envía.
VAPID_SUBJECT=mailto:avisos@tu-club.es
# Activa las rutas públicas antiguas /api/status y /api/inscripciones. Déjalo en false.
ENABLE_PUBLIC_WRITE_ROUTES=false
